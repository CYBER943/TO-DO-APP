{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "dailyFocusGoal": { "type": "integer" }
      },
      "required": ["uid", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "A task item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "projectId": { "type": "string" },
        "completed": { "type": "boolean" },
        "subtasks": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "uid": { "type": "string" },
        "isFocus": { "type": "boolean" }
      },
      "required": ["id", "title", "uid"]
    },
    "Project": {
      "title": "Project",
      "description": "A project container for tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "uid"]
    },
    "Tag": {
      "title": "Tag",
      "description": "A label for tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "uid"]
    },
    "Section": {
      "title": "Section",
      "description": "A column or section within a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "projectId": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "projectId", "order"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/users/{userId}/tags/{tagId}": {
      "schema": "Tag",
      "description": "User tags"
    },
    "/users/{userId}/sections/{sectionId}": {
      "schema": "Section",
      "description": "User project sections"
    }
  }
}
